{
  // Atelier : site statique (dist) + Worker pour /api (catalogue de tissus importés dans R2).
  "name": "atelier-costume",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "costume.jbleroy.fr", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "atelier-costume-tissus" }],
  // Administration (/admin, /admin-commandes, /api/admin) : protégée par Cloudflare Access
  // (application « Atelier – administration »). Le Worker vérifie lui-même la signature du jeton Access ;
  // ces deux valeurs ne sont pas secrètes (domaine de l'organisation et identifiant de l'application).
  "vars": {
    "ACCESS_TEAM": "rapid-morning-e18f.cloudflareaccess.com",
    "ACCESS_AUD": "4f2fe6dee5c97a8bb925251243b7578287fe0da5d8ef81eb0d1ba83ba5cf1c54"
  }
}
